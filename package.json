{
  "name": "beauty-by-layna",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:worker": "wrangler deploy --config wrangler.local.jsonc --dry-run --outdir .test-output/worker",
    "dev": "npm run build && wrangler dev --config wrangler.local.jsonc --local --ip 127.0.0.1",
    "db:migrate:local": "wrangler d1 migrations apply REVIEWS_DB --config wrangler.local.jsonc --local",
    "worker:config": "node scripts/worker-config.mjs",
    "admin:password": "node scripts/admin-password.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "devDependencies": {
    "miniflare": "5.20261104.0-beta",
    "wrangler": "4.158.0"
  },
  "engines": {
    "node": ">=22"
  }
}
